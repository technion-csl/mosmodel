MODULE_NAME := experiments/smt_corunner_single_page_size
SMT_CORUNNER_SINGLE_PAGE_SIZE_LAYOUTS := layout4kb layout2mb layout1gb
SMT_CORUNNER_LAYOUTS_DIR := $(MODULE_NAME)/layouts
SMT_CORUNNER_LAYOUT_FILES := $(addprefix $(SMT_CORUNNER_LAYOUTS_DIR)/,$(addsuffix .csv,$(SMT_CORUNNER_SINGLE_PAGE_SIZE_LAYOUTS)))

$(MODULE_NAME): $(SMT_CORUNNER_LAYOUT_FILES)
$(SMT_CORUNNER_LAYOUTS_DIR): $(SMT_CORUNNER_LAYOUT_FILES)

CREATE_SMT_CORUNNER_SINGLE_PAGE_LAYOUTS := experiments/single_page_size/createLayouts.py
$(SMT_CORUNNER_LAYOUT_FILES): $(SMT_CORUNNER_MEMORY_FOOTPRINT_FILE)
	$(CREATE_SMT_CORUNNER_SINGLE_PAGE_LAYOUTS) --memory_footprint=$< \
		--output=$(SMT_CORUNNER_LAYOUTS_DIR)/..

$(MODULE_NAME)/clean:
	rm -rf $(SMT_CORUNNER_LAYOUTS_DIR)
